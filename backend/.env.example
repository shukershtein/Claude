# Server
PORT=8080
HOST=0.0.0.0

# Single-device auth — generate something random and copy to the Android app
DEVICE_TOKEN=replace-me-with-a-random-string

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://agent:agent@localhost:5432/agent

# Claude
# When using a Max subscription via the Agent SDK, log in once on the VPS with
# the Claude Code CLI (`claude login`). Tokens are cached in ~/.config/anthropic/
# and the SDK picks them up automatically — no API key needed.
#
# To fall back to a pay-per-token API key, uncomment:
# ANTHROPIC_API_KEY=sk-ant-...

# Default model for everyday turns
AGENT_MODEL=claude-sonnet-4-5
